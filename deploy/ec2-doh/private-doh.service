[Unit]
Description=Private allowlist DNS over HTTPS origin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/private-doh.env
ExecStart=/usr/bin/python3 /opt/private-doh/doh_server.py
Restart=always
RestartSec=2
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
