DOH_BIND=0.0.0.0
DOH_PORT=80
DOH_QUERY_PATH=/dns-query
DOH_ADMIN_PATH=/_admin/doh-sync
DOH_HMAC_SECRET=replace-with-the-same-random-secret-used-in-cloudflare-dns
# Keep the old URL working during migration. Comma-separate more than one path.
DOH_LEGACY_QUERY_PATHS=/replace-this-with-your-old-secret-path/dns-query
DOH_CONFIG_PATH=/var/lib/private-doh/records.json
DOH_VPC_RESOLVER=169.254.169.253
DOH_VPC_RESOLVER_TIMEOUT_SECONDS=5
DOH_MAX_ADMIN_SKEW_SECONDS=300
